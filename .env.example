# Copy to .env.local and adjust. Never commit real values.

# Public base URL of the site, used for canonical URLs, hreflang, the sitemap,
# robots.txt, JSON-LD and OG image URLs. Inlined at build time: the production
# build must run with https://laurinwerner.com.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Error monitoring with self-hosted GlitchTip (D5). Without a DSN nothing is sent.
# The DSN is inlined into the browser bundle at build time; browser reports go
# through the same-origin tunnel /monitoring, server reports go directly.
NEXT_PUBLIC_SENTRY_DSN=

# Source map upload at build time (optional; skipped without an auth token).
SENTRY_URL=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Set to "enabled" (at runtime) to make /monitoring/test throw a test error.
MONITORING_TEST=
